# ═══════════════════════════════════════════════════════════════
# data/: current evaluation results ARE committed (final_NB/WB.json,
# uncoded_ref.json, awgn_fine.json, ablate_ofdm.json, tables/, logs/);
# superseded intermediates and external-comparison logs are not.
# ═══════════════════════════════════════════════════════════════
data/legacy/
data/logs/realistic_*.log
data/logs/extend_deep.log

# results/ — legacy April uncoded-suite outputs: ignore everything except
# the report-grade digests kept for continuity with earlier releases
# (their pipeline now lives in archive/legacy_uncoded/).
results/*
!results/otfs_eval_v1.json
!results/figures/
results/figures/*
!results/figures/tab_eval_BERat20dB.csv
!results/figures/tab_eval_SNRforBER.csv
!results/figures/tab_eval_winner.csv

